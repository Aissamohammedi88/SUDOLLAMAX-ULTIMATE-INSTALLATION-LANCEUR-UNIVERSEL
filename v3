#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
SUDOLLAMAX ULTIMATE — LE CLIENT UNIVERSEL
Auteur : Aissa Mohammedi (DGK) — Nexus Quantum
Description : Détecte le format du modèle et utilise le meilleur moteur.
"""

import os
import sys
import subprocess
from pathlib import Path

# ═══════════════════════════════════════════════════════════════
# DÉTECTION AUTO (LE RADAR)
# ═══════════════════════════════════════════════════════════════

def detect_model_type(model_path):
    path = Path(model_path)
    if path.is_dir():
        if (path / "config.json").exists():
            return "huggingface"
        if (path / "saved_model.pb").exists():
            return "tensorflow"
        if (path / "pytorch_model.bin").exists() or (path / "model.pt").exists():
            return "pytorch"
        if (path / "model.onnx").exists():
            return "onnx"
        if (path / "model.engine").exists():
            return "tensorrt"
    if path.suffix == ".gguf":
        return "ollama"
    return "unknown"

# ═══════════════════════════════════════════════════════════════
# LES MOTEURS D'EXÉCUTION
# ═══════════════════════════════════════════════════════════════

def run_ollama(model_path):
    subprocess.run(["ollama", "run", str(model_path)])

def run_huggingface(model_path):
    from transformers import pipeline
    info("Chargement via HuggingFace Transformers...")
    pipe = pipeline("text-generation", model=str(model_path))
    result = pipe("Hello world", max_new_tokens=50)
    print(result[0]["generated_text"])

def run_pytorch(model_path):
    import torch
    info("Chargement via PyTorch natif...")
    model = torch.load(model_path / "pytorch_model.bin", map_location="cpu")
    print(f"Modèle chargé : {model.__class__.__name__}")

def run_tensorflow(model_path):
    import tensorflow as tf
    info("Chargement via TensorFlow SavedModel...")
    model = tf.saved_model.load(str(model_path))
    print(f"Signatures : {list(model.signatures.keys())}")

def run_onnx(model_path):
    import onnxruntime as ort
    info("Chargement via ONNX Runtime...")
    session = ort.InferenceSession(str(model_path / "model.onnx"))
    print(f"Entrées : {[i.name for i in session.get_inputs()]}")

def run_tensorrt(model_path):
    import tensorrt as trt
    info("Chargement via TensorRT Engine...")
    logger = trt.Logger(trt.Logger.WARNING)
    with open(model_path / "model.engine", "rb") as f:
        runtime = trt.Runtime(logger)
        engine = runtime.deserialize_cuda_engine(f.read())
    print("Moteur TensorRT chargé.")

# ═══════════════════════════════════════════════════════════════
# MAIN (LE ROUTEUR)
# ═══════════════════════════════════════════════════════════════

def main():
    if len(sys.argv) < 2:
        print("Usage: sudollamax.py <model_path_or_name>")
        sys.exit(1)

    model_path = sys.argv[1]
    model_type = detect_model_type(model_path)
    
    print(f"\033[1;36m[SUDOLLAMAX]\033[0m Type détecté : \033[1;32m{model_type}\033[0m")

    runners = {
        "ollama": run_ollama,
        "huggingface": run_huggingface,
        "pytorch": run_pytorch,
        "tensorflow": run_tensorflow,
        "onnx": run_onnx,
        "tensorrt": run_tensorrt,
    }

    runner = runners.get(model_type)
    if runner:
        runner(model_path)
    else:
        print(f"\033[1;31m[ERREUR]\033[0m Format non supporté : {model_type}")

if __name__ == "__main__":
    main()
PYTHON_EOF

