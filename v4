#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
# SUDOLLAMAX ULTIMATE v2.1.0 — CLIENT UNIVERSEL (édition senior)
# Auteur : Aissa Mohammedi (DGK) — Nexus Quantum
# ═══════════════════════════════════════════════════════════════════════════════
set -uo pipefail   # PAS de -e : on gère chaque échec manuellement

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'
info() { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
fail() { echo -e "${RED}[ERREUR]${NC} $1"; }
section() { echo -e "\n${BLUE}===== $1 =====${NC}"; }

BASE_DIR="${HOME}/sudollamax_ultimate"
STACKS_DIR="${BASE_DIR}/stacks"
MODELS_DIR="${BASE_DIR}/models"
LOGS_DIR="${BASE_DIR}/logs"
BIN_DIR="${HOME}/.local/bin"
mkdir -p "$BASE_DIR" "$STACKS_DIR" "$MODELS_DIR" "$LOGS_DIR" "$BIN_DIR"

# ─── 0. DÉTECTION GPU (avant toute installation lourde) ────────────────────────
detect_gpu() {
    if command -v nvidia-smi &>/dev/null && nvidia-smi &>/dev/null; then
        echo "nvidia"
    elif [[ "$(uname -m)" == "arm64" ]] && [[ "$(uname)" == "Darwin" ]]; then
        echo "apple"
    else
        echo "cpu"
    fi
}
GPU_MODE="$(detect_gpu)"
info "Mode GPU détecté : ${CYAN}${GPU_MODE}${NC}"

# ─── 1. DÉPENDANCES SYSTÈME (sans CUDA toolkit par défaut) ────────────────────
section "1. DÉPENDANCES SYSTÈME"
sudo apt-get update -qq || warn "apt update a échoué (on continue)"
sudo apt-get install -y -qq \
    python3 python3-pip python3-venv python3-dev \
    build-essential git curl wget cmake g++ \
    libopenblas-dev libssl-dev pkg-config \
    || { fail "apt install a échoué"; exit 1; }
info "Dépendances système installées"

if [[ "$GPU_MODE" == "nvidia" ]]; then
    warn "CUDA toolkit détecté comme nécessaire — installation (~3 GB)"
    sudo apt-get install -y -qq nvidia-cuda-toolkit || warn "CUDA toolkit échoué (on continue en CPU)"
else
    info "Pas de GPU NVIDIA — skip nvidia-cuda-toolkit (économie 3 GB)"
fi

# ─── 2. OLLAMA ────────────────────────────────────────────────────────────────
section "2. OLLAMA"
if ! command -v ollama &>/dev/null; then
    curl -fsSL https://ollama.com/install.sh | sh || { fail "Ollama échoué"; exit 1; }
fi
export OLLAMA_MODELS="${MODELS_DIR}"
grep -q "OLLAMA_MODELS" ~/.bashrc 2>/dev/null || \
    echo "export OLLAMA_MODELS=\"${MODELS_DIR}\"" >> ~/.bashrc
info "Ollama prêt — modèles dans ${MODELS_DIR}"

# ─── 3. TROIS VENVS SÉPARÉS (le vrai fix du conflit TF/PyTorch) ───────────────
section "3. VENVS ISOLÉS (torch / tf / main)"
make_venv() {
    local name="$1"
    local dir="${STACKS_DIR}/venv-${name}"
    if [[ ! -d "$dir" ]]; then
        python3 -m venv "$dir" || { fail "venv ${name} échoué"; return 1; }
    fi
    # shellcheck disable=SC1091
    source "${dir}/bin/activate"
    pip install -q --upgrade pip setuptools wheel
    deactivate
    info "venv-${name} prêt"
}
make_venv main || exit 1
make_venv torch || exit 1
make_venv tf    || exit 1

# ─── 4. STACK TORCH (PyTorch + HF + ONNX + TensorRT) ──────────────────────────
section "4. STACK TORCH"
source "${STACKS_DIR}/venv-torch/bin/activate"
if [[ "$GPU_MODE" == "nvidia" ]]; then
    pip install -q torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
else
    pip install -q torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu
fi
pip install -q transformers accelerate huggingface-hub sentencepiece protobuf
pip install -q onnx onnxruntime
# TensorRT : seulement si système l'a (nvidia-tensorrt pip est cassé)
if [[ "$GPU_MODE" == "nvidia" ]] && dpkg -l 2>/dev/null | grep -q tensorrt; then
    pip install -q tensorrt || warn "tensorrt pip échoué (déjà côté système ?)"
fi
deactivate
info "Stack torch prête"

# ─── 5. STACK TF (isolée) ─────────────────────────────────────────────────────
section "5. STACK TF"
source "${STACKS_DIR}/venv-tf/bin/activate"
pip install -q tensorflow || warn "tensorflow échoué (on continue)"
deactivate
info "Stack tf prête"

# ─── 6. STACK MAIN (JAX + utilitaires) ────────────────────────────────────────
section "6. STACK MAIN"
source "${STACKS_DIR}/venv-main/bin/activate"
if [[ "$GPU_MODE" == "nvidia" ]]; then
    pip install -q "jax[cuda12]" || pip install -q jax jaxlib
else
    pip install -q jax jaxlib
fi
pip install -q flask requests numpy pandas scikit-learn
deactivate
info "Stack main prête"

# ─── 7. LE LANCEUR PYTHON (corrigé) ───────────────────────────────────────────
section "7. LANCEUR PYTHON"
cat > "${BASE_DIR}/sudollamax.py" << 'PYEOF'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""SUDOLLAMAX ULTIMATE — Client universel (Python corrigé)."""
import os, sys, subprocess
from pathlib import Path

def info(m):  print(f"\033[0;32m[OK]\033[0m {m}")
def warn(m):  print(f"\033[1;33m[WARN]\033[0m {m}")
def fail(m):  print(f"\033[0;31m[ERREUR]\033[0m {m}", file=sys.stderr)

def detect_model_type(model_path: str) -> str:
    p = Path(model_path).expanduser()
    if p.is_dir():
        if (p / "config.json").exists():        return "huggingface"
        if (p / "saved_model.pb").exists():     return "tensorflow"
        if (p / "pytorch_model.bin").exists() or (p / "model.pt").exists():
            return "pytorch"
        if (p / "model.onnx").exists():         return "onnx"
        if (p / "model.engine").exists():       return "tensorrt"
    if p.suffix == ".gguf" or (p.is_file() and "gguf" in p.name.lower()):
        return "ollama"
    return "unknown"

def run_ollama(model_path: str, prompt: str = "Hello"):
    subprocess.run(["ollama", "run", str(model_path), prompt], check=False)

def run_huggingface(model_path: str, prompt: str = "Hello"):
    from transformers import pipeline
    info("Chargement HuggingFace Transformers…")
    pipe = pipeline("text-generation", model=str(Path(model_path).expanduser()))
    out = pipe(prompt, max_new_tokens=50)
    print(out[0]["generated_text"])

def run_pytorch(model_path: str, prompt: str = ""):
    import torch
    p = Path(model_path).expanduser()
    info("Chargement PyTorch natif…")
    weights = p / "pytorch_model.bin"
    if not weights.exists():
        weights = p / "model.pt"
    model = torch.load(weights, map_location="cpu")
    print(f"Modèle chargé : {model.__class__.__name__}")
    if prompt:
        warn(f"Prompt ignoré (pas de tokenizer) : {prompt!r}")

def run_tensorflow(model_path: str, prompt: str = ""):
    import tensorflow as tf
    p = Path(model_path).expanduser()
    info("Chargement TensorFlow SavedModel…")
    model = tf.saved_model.load(str(p))
    print(f"Signatures : {list(model.signatures.keys())}")

def run_onnx(model_path: str, prompt: str = ""):
    import onnxruntime as ort
    p = Path(model_path).expanduser()
    info("Chargement ONNX Runtime…")
    session = ort.InferenceSession(str(p / "model.onnx"))
    print(f"Entrées : {[i.name for i in session.get_inputs()]}")

def run_tensorrt(model_path: str, prompt: str = ""):
    import tensorrt as trt
    p = Path(model_path).expanduser()
    info("Chargement TensorRT Engine…")
    logger = trt.Logger(trt.Logger.WARNING)
    with open(p / "model.engine", "rb") as f:
        engine = trt.Runtime(logger).deserialize_cuda_engine(f.read())
    print(f"Moteur TensorRT chargé : {'OK' if engine else 'FAIL'}")

def main():
    if len(sys.argv) < 2:
        print("Usage: sudollamax <model_path_or_name> [prompt]"); sys.exit(1)
    model_path = sys.argv[1]
    prompt = sys.argv[2] if len(sys.argv) > 2 else "Hello"
    mtype = detect_model_type(model_path)
    print(f"\033[1;36m[SUDOLLAMAX]\033[0m Type : \033[1;32m{mtype}\033[0m")
    runners = {"ollama": run_ollama, "huggingface": run_huggingface,
               "pytorch": run_pytorch, "tensorflow": run_tensorflow,
               "onnx": run_onnx, "tensorrt": run_tensorrt}
    runner = runners.get(mtype)
    if runner: runner(model_path, prompt)
    else:      fail(f"Format non supporté : {mtype}"); sys.exit(2)

if __name__ == "__main__":
    main()
PYEOF
chmod +x "${BASE_DIR}/sudollamax.py"
info "Lanceur Python écrit"

# ─── 8. WRAPPER GLOBAL (pas d'alias fragile) ─────────────────────────────────
section "8. WRAPPER GLOBAL"
cat > "${BIN_DIR}/sudollamax" << 'WRAPPER'
#!/usr/bin/env bash
# Route vers le bon venv selon le type de modèle
BASE_DIR="${HOME}/sudollamax_ultimate"
STACKS="${BASE_DIR}/stacks"
MODEL="${1:-}"; PROMPT="${2:-Hello}"
if [[ -z "$MODEL" ]]; then echo "Usage: sudollamax <model> [prompt]"; exit 1; fi

# Détection rapide pour choisir le venv
TYPE=$(python3 - <<PY
from pathlib import Path
p = Path("${MODEL}").expanduser()
t = "unknown"
if p.is_dir():
    if (p/"saved_model.pb").exists(): t = "tensorflow"
    elif (p/"config.json").exists() or (p/"pytorch_model.bin").exists() or (p/"model.pt").exists(): t = "torch"
    elif (p/"model.onnx").exists() or (p/"model.engine").exists(): t = "torch"
elif p.suffix == ".gguf": t = "ollama"
print(t)
PY
)
case "$TYPE" in
    ollama)     exec ollama run "$MODEL" "$PROMPT" ;;
    torch)      source "${STACKS}/venv-torch/bin/activate" && exec python3 "${BASE_DIR}/sudollamax.py" "$MODEL" "$PROMPT" ;;
    tensorflow) source "${STACKS}/venv-tf/bin/activate"    && exec python3 "${BASE_DIR}/sudollamax.py" "$MODEL" "$PROMPT" ;;
    *)          source "${STACKS}/venv-main/bin/activate"  && exec python3 "${BASE_DIR}/sudollamax.py" "$MODEL" "$PROMPT" ;;
esac
WRAPPER
chmod +x "${BIN_DIR}/sudollamax"

# Ajouter ~/.local/bin au PATH si nécessaire
grep -q 'HOME/.local/bin' ~/.bashrc 2>/dev/null || \
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
info "Wrapper : ${BIN_DIR}/sudollamax"

# ─── 9. TEST ─────────────────────────────────────────────────────────────────
section "9. TEST"
if command -v ollama &>/dev/null; then
    ollama pull qwen2.5-coder:1.5b || warn "pull échoué"
    info "Test avec prompt (pas de blocage interactif) :"
    "${BIN_DIR}/sudollamax" qwen2.5-coder:1.5b "dis bonjour en 5 mots" || warn "test échoué"
else
    warn "Ollama absent, test sauté"
fi

# ─── 10. RAPPORT ─────────────────────────────────────────────────────────────
section "RAPPORT — SUDOLLAMAX ULTIMATE v2.1.0"
echo "📁 Base       : $BASE_DIR"
echo "🐍 Venvs      : $STACKS_DIR/venv-{main,torch,tf}"
echo "📦 Modèles    : $MODELS_DIR (OLLAMA_MODELS)"
echo "🚀 Wrapper    : $BIN_DIR/sudollamax"
echo "🧠 GPU        : $GPU_MODE"
echo "📌 Usage      : sudollamax <model> [prompt]"
echo "✅ Le Client Universel est prêt."
